---
import Arrow from '../components/Arrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getContact, getHomepage } from '../content';
import { innerFooter, route, t, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/contact.css';
import { sitePath } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = t(locale);
const home = getHomepage(locale);
const page = getContact(locale);
const footer = innerFooter(home.footer, locale);
---

<BaseLayout title={page.meta.title} description={page.meta.description} locale={locale} routeKey="contact">
  <SiteHeader nav={home.nav} access={home.hero.access} logoHref={route('home', locale)} locale={locale} routeKey="contact" />
  <main id="contenu" class="contact">
    <section class="hero" data-motion="hero" aria-labelledby="contact-title">
      <div class="wrap">
        <p class="kicker">{page.hero.eyebrow}</p>
        <h1 id="contact-title">{page.hero.title}</h1>
        <p class="lead">{page.hero.lead}</p>
      </div>
    </section>

    <section class="intents" id="motifs" aria-labelledby="intents-title">
      <div class="wrap">
        <h2 id="intents-title">{page.intents.title}</h2>
        <p class="dek">{page.intents.dek}</p>
        <div class="intent-grid" role="group" aria-label={text.aria.intent}>
          {page.intents.items.map((item) => (
            <button class="intent" type="button" data-subject={item.subject} aria-pressed="false">
              <strong>{item.title}</strong>
              <span>{item.text}</span>
              <span class="go">{page.intents.choose}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="write" id="ecrire" aria-labelledby="write-title">
      <div class="wrap">
        <h2 id="write-title">{page.email.title}</h2>
        <p class="dek">{page.email.dek}</p>
        <a class="address" id="address" href={sitePath(page.email.href)}>{page.email.address}</a>
        <div class="write-actions">
          <a
            class="btn btn-primary"
            id="write-cta"
            href={sitePath(page.email.href)}
            data-base={page.email.href}
            data-email={page.email.address}
            data-optional={text.contact.optional}
            data-subject-template={text.contact.subject}
          >{page.email.cta} <Arrow /></a>
          <p class="subject" id="subject-note" aria-live="polite">{text.contact.optional}</p>
        </div>
      </div>
    </section>

    <section class="bridges" aria-label={text.aria.bridges}>
      <div class="wrap bridge-grid">
        <article class="bridge bridge-aide">
          <h2>{page.aide.title}</h2>
          <p>{page.aide.support}</p>
          <a class="text-link" href={sitePath(page.aide.href)}>{page.aide.cta} <Arrow /></a>
        </article>
        <article class="bridge bridge-social">
          <h2>{page.social.title}</h2>
          <p>{page.social.support}</p>
          <SocialLinks locale={locale} tone="light" />
        </article>
      </div>
    </section>

    <section class="final" aria-labelledby="final-title">
      <div class="wrap">
        <div class="final-band">
          <h2 id="final-title">{page.application.title}</h2>
          <a class="btn btn-primary" href={sitePath(page.application.href)}>{page.application.cta} <Arrow /></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter footer={footer} locale={locale} homeHref={route('home', locale)} currentPath={route('contact', locale)} />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.contact .intent'));
  const cta = document.getElementById('write-cta');
  const note = document.getElementById('subject-note');
  const base = cta?.dataset.base || '';
  const optional = cta?.dataset.optional || '';
  const template = cta?.dataset.subjectTemplate || '';
  const email = cta?.dataset.email || '';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (cta && note) {
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const subject = button.dataset.subject || '';
        const on = button.getAttribute('aria-pressed') === 'true';
        for (const other of buttons) other.setAttribute('aria-pressed', 'false');
        if (on) {
          cta.setAttribute('href', base);
          note.textContent = optional;
          return;
        }
        button.setAttribute('aria-pressed', 'true');
        cta.setAttribute('href', `${base}?subject=${encodeURIComponent(subject)}`);
        note.textContent = template.replace('{subject}', subject).replace('{email}', email);
        document.getElementById('ecrire')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    }
  }
</script>
