---
import AudienceSplit from '../components/AudienceSplit.astro';
import Audiences from '../components/Audiences.astro';
import Cameroon from '../components/Cameroon.astro';
import FinalCta from '../components/FinalCta.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MiniJobsTeaser from '../components/MiniJobsTeaser.astro';
import MobileApp from '../components/MobileApp.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHomepage } from '../content';
import type { Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getHomepage(locale);
---

<BaseLayout title={page.meta.title} description={page.meta.description} locale={locale} routeKey="home">
  <div id="accueil">
    <SiteHeader nav={page.nav} access={page.hero.access} locale={locale} routeKey="home" />
    <main id="contenu">
      <Hero hero={page.hero} stores={page.mobile.stores} locale={locale} />
      <Audiences audiences={page.audiences} />
      <ProductShowcase product={page.product} locale={locale} />
      <HowItWorks steps={page.steps} />
      <AudienceSplit professionals={page.professionals} organisations={page.organisations} locale={locale} />
      <MiniJobsTeaser minijobs={page.minijobs} />
      <Cameroon cameroon={page.cameroon} locale={locale} />
      <MobileApp mobile={page.mobile} locale={locale} />
      <FinalCta finale={page.finale} />
    </main>
    <SiteFooter footer={page.footer} locale={locale} />
  </div>
</BaseLayout>
