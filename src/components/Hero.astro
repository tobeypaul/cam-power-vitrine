---
import screenNetwork from '../assets/screens/screen-network.jpg';
import screenOffers from '../assets/screens/screen-offers.jpg';
import Arrow from './Arrow.astro';
import PhoneFrame from './PhoneFrame.astro';
import StoreBadges from './StoreBadges.astro';
import type { HomepageContent, StoreLink } from '../content/types';
import { t, type Locale } from '../i18n';
import { sitePath } from '../lib/paths';

interface Props {
  hero: HomepageContent['hero'];
  stores: StoreLink[];
  locale: Locale;
}

const { hero, stores, locale } = Astro.props;
---

<section class="hero" data-motion="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">
        {hero.titleLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={sitePath(hero.discover.href)}>{hero.discover.label}</a>
        <a class="btn btn-primary" href={sitePath(hero.access.href)}>{hero.access.label} <Arrow /></a>
      </div>
      <StoreBadges stores={stores} locale={locale} compact />
      <ul class="signals">
        {hero.signals.map((signal) => <li>{signal}</li>)}
      </ul>
    </div>
    <div class="hero-visual">
      <PhoneFrame src={screenNetwork} alt="" frameClass="back" eager variant="default" />
      <PhoneFrame
        src={screenOffers}
        alt={t(locale).alt.heroOffers}
        frameClass="front"
        eager
        variant="offers"
      />
      <aside class="chip">
        <span class="chip-k">{hero.chip.kicker}</span>
        <strong>{hero.chip.title}</strong>
        <em>{hero.chip.meta}</em>
      </aside>
    </div>
  </div>
</section>
