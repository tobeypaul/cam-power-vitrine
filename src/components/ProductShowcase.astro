---
import screenNetwork from '../assets/screens/screen-network.jpg';
import screenOffers from '../assets/screens/screen-offers.jpg';
import screenProfile from '../assets/screens/screen-profile.jpg';
import PhoneFrame from './PhoneFrame.astro';
import type { HomepageContent } from '../content/types';
import { t, type Locale } from '../i18n';

interface Props {
  product: HomepageContent['product'];
  locale: Locale;
}

const { product, locale } = Astro.props;
const alt = t(locale).alt;
---

<section class="action" id="action" data-motion="reveal" aria-labelledby="action-title">
  <div class="wrap">
    <h2 id="action-title">{product.title}</h2>
    <p class="dek">{product.dek}</p>
    <div class="stage">
      <ul class="calls left">
        {product.left.map((item) => <li>{item}</li>)}
      </ul>
      <div class="trio">
        <PhoneFrame src={screenProfile} alt={alt.profile} />
        <PhoneFrame src={screenOffers} alt={alt.offersScreen} variant="offers" />
        <PhoneFrame src={screenNetwork} alt={alt.network} />
      </div>
      <ul class="calls right">
        {product.right.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
