---
import logo from '../assets/brand/logo.png';
import { sitePath } from '../lib/paths';

interface Props {
  href?: string;
  label?: string;
}

const { href = '#accueil', label = 'CamPower, accueil' } = Astro.props;
---

<a class="brand" href={sitePath(href)} aria-label={label}>
  <img src={logo.src} width={logo.width} height={logo.height} alt="" />
</a>
