---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  variant?: 'default' | 'offers' | 'profile';
  frameClass?: string;
  eager?: boolean;
}

const { src, alt, variant = 'default', frameClass, eager = false } = Astro.props;
---

<div class:list={['phone', frameClass]} aria-hidden={alt === '' ? 'true' : undefined}>
  <div class:list={['screen', 'shot', variant === 'offers' && 'shot-offers', variant === 'profile' && 'shot-profile']}>
    <Image
      src={src}
      alt={alt}
      widths={[280, 420, 640]}
      sizes="(max-width: 720px) 46vw, 246px"
      quality={75}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</div>
