---
import Arrow from './Arrow.astro';
import Logo from './Logo.astro';
import type { LinkItem, NavItem } from '../content/types';
import { sitePath } from '../lib/paths';

interface Props {
  nav: NavItem[];
  access: LinkItem;
  logoHref?: string;
}

const { nav, access, logoHref } = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="bar wrap">
    {logoHref ? <Logo href={sitePath(logoHref)} /> : <Logo />}
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-bars"></span>
      <span class="sr-only" data-nav-label>Ouvrir le menu</span>
    </button>
    <a class="btn btn-primary" href={sitePath(access.href)}>{access.label} <Arrow /></a>
    <nav id="site-nav" class="nav" data-site-nav aria-label="Navigation principale">
      {nav.map((item) =>
        item.href ? (
          <a href={sitePath(item.href)} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ) : (
          <span>{item.label}</span>
        )
      )}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-site-nav]');
  const label = header?.querySelector('[data-nav-label]');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let closeTimer = 0;

  function motionOn() {
    return document.documentElement.classList.contains('motion-ready') && !reduceMotion.matches;
  }

  function setOpen(open: boolean) {
    if (!button || !nav) return;
    window.clearTimeout(closeTimer);
    button.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    if (open) {
      nav.classList.add('is-open');
      if (motionOn()) {
        nav.classList.remove('is-shown');
        void nav.offsetWidth;
        nav.classList.add('is-shown');
      } else {
        nav.classList.add('is-shown');
      }
      nav.querySelector('a')?.focus();
      return;
    }
    if (motionOn() && nav.classList.contains('is-open')) {
      nav.classList.remove('is-shown');
      closeTimer = window.setTimeout(() => {
        if (button.getAttribute('aria-expanded') === 'false') nav.classList.remove('is-open');
      }, 160);
      return;
    }
    nav.classList.remove('is-open', 'is-shown');
  }

  button?.addEventListener('click', () => {
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });

  const desktop = window.matchMedia('(min-width: 981px)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
