---
import Arrow from './Arrow.astro';
import Logo from './Logo.astro';
import type { LinkItem, NavItem } from '../content/types';
import { htmlLang, otherLocale, route, t, type Locale, type RouteKey } from '../i18n';
import { sitePath } from '../lib/paths';

interface Props {
  nav: NavItem[];
  access: LinkItem;
  logoHref?: string;
  locale: Locale;
  routeKey: RouteKey;
}

const { nav, access, logoHref, locale, routeKey } = Astro.props;
const text = t(locale);
const other = otherLocale(locale);
---

<header class="site-header" data-site-header>
  <div class="bar wrap">
    {logoHref ? <Logo href={sitePath(logoHref)} label={text.homeLabel} /> : <Logo label={text.homeLabel} />}
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      data-label-open={text.menuOpen}
      data-label-close={text.menuClose}
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-toggle-bars"></span>
      <span class="sr-only" data-nav-label>{text.menuOpen}</span>
    </button>
    <div class="bar-end">
      <a
        class="lang"
        href={sitePath(route(routeKey, other))}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        aria-label={text.switchLabel}
      >
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="7.4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M2.6 10h14.8M10 2.6c2 2.1 3 4.6 3 7.4s-1 5.3-3 7.4c-2-2.1-3-4.6-3-7.4s1-5.3 3-7.4Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
        {text.switchText}
      </a>
      <a class="btn btn-primary" href={sitePath(access.href)}>{access.label} <Arrow /></a>
    </div>
    <nav id="site-nav" class="nav" data-site-nav aria-label={text.mainNav}>
      {nav.map((item) =>
        item.href ? (
          <a href={sitePath(item.href)} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ) : (
          <span>{item.label}</span>
        )
      )}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-site-nav]');
  const label = header?.querySelector('[data-nav-label]');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let closeTimer = 0;

  function motionOn() {
    return document.documentElement.classList.contains('motion-ready') && !reduceMotion.matches;
  }

  function setOpen(open: boolean) {
    if (!button || !nav) return;
    window.clearTimeout(closeTimer);
    button.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? button.dataset.labelClose : button.dataset.labelOpen) || '';
    if (open) {
      nav.classList.add('is-open');
      if (motionOn()) {
        nav.classList.remove('is-shown');
        void nav.offsetWidth;
        nav.classList.add('is-shown');
      } else {
        nav.classList.add('is-shown');
      }
      nav.querySelector('a')?.focus();
      return;
    }
    if (motionOn() && nav.classList.contains('is-open')) {
      nav.classList.remove('is-shown');
      closeTimer = window.setTimeout(() => {
        if (button.getAttribute('aria-expanded') === 'false') nav.classList.remove('is-open');
      }, 160);
      return;
    }
    nav.classList.remove('is-open', 'is-shown');
  }

  button?.addEventListener('click', () => {
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });

  const desktop = window.matchMedia('(min-width: 981px)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
