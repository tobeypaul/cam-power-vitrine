---
import Arrow from './Arrow.astro';
import type { HomepageContent } from '../content/types';

interface Props {
  audiences: HomepageContent['audiences'];
}

const { audiences } = Astro.props;

const icons = {
  talents: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M5.4 19.2c1.3-3 3.6-4.6 6.6-4.6s5.3 1.6 6.6 4.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>`,
  entreprises: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8.6L12 4l8 4.6V20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path><path d="M9.2 20v-5h5.6v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>`,
  missions: `<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle><circle cx="12" cy="12" r="2.3" fill="currentColor"></circle></svg>`,
};
---

<section class="needs" id="besoins" aria-labelledby="needs-title">
  <div class="wrap">
    <div class="needs-head" data-motion="reveal">
      <h2 id="needs-title">
        {audiences.titleLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p>{audiences.dek}</p>
    </div>
    <div class="doors">
      {audiences.items.map((item, index) => (
        <article class:list={['door', item.tone === 'emphasis' && 'door-em']} id={item.id} data-motion="reveal" style={`--motion-i:${index + 1}`}>
          <span class:list={['tick', item.id === 'talents' ? 'tick-g' : 'tick-y']}></span>
          <Fragment set:html={icons[item.id as keyof typeof icons]} />
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <a class="more" href={item.cta.href}>{item.cta.label} <Arrow /></a>
        </article>
      ))}
    </div>
  </div>
</section>
