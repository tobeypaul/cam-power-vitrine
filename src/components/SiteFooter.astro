---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import type { HomepageContent } from '../content/types';
import { route, t, type Locale } from '../i18n';
import { sitePath } from '../lib/paths';

interface Props {
  footer: HomepageContent['footer'];
  locale: Locale;
  homeHref?: string;
  currentPath?: string;
}

const { footer, locale, homeHref = '#accueil', currentPath } = Astro.props;
const text = t(locale);
const mentionsPath = route('mentions', locale);
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <Logo href={sitePath(homeHref)} label="CamPower" />
        <p class="tagline">{footer.tagline}</p>
      </div>
      {footer.columns.map((column) => (
        <div>
          <h2>{column.title}</h2>
          {column.links.map((link) => (
            <a
              href={sitePath(link.href)}
              id={link.href === mentionsPath ? 'mentions' : undefined}
              aria-current={currentPath && link.href === currentPath ? 'page' : undefined}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
              {link.external && <span class="sr-only">{text.newTab}</span>}
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="foot-base">
      <a href={sitePath(footer.email.href)}>{footer.email.label}</a>
      <span>{footer.location}</span>
      <SocialLinks locale={locale} />
      <span class="grow">{footer.copyright}</span>
    </div>
  </div>
</footer>
