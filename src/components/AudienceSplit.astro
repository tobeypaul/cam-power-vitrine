---
import { Image } from 'astro:assets';
import screenProfile from '../assets/screens/screen-profile.jpg';
import type { HomepageContent } from '../content/types';
import { t, type Locale } from '../i18n';
import { sitePath } from '../lib/paths';

interface Props {
  professionals: HomepageContent['professionals'];
  organisations: HomepageContent['organisations'];
  locale: Locale;
}

const { professionals, organisations, locale } = Astro.props;
---

<section class="split" data-motion="reveal">
  <div class="split-col" id={professionals.id}>
    <div class="inner">
      <p class="kicker">{professionals.kicker}</p>
      <h2>
        {professionals.titleLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <p class="support">{professionals.support}</p>
      <figure class="idcard">
        <Image
          src={screenProfile}
          alt={t(locale).alt.profileCard}
          widths={[250, 500]}
          sizes="250px"
          quality={80}
        />
      </figure>
      <a class="btn btn-line" href={sitePath(professionals.cta.href)}>{professionals.cta.label}</a>
    </div>
  </div>
  <div class="split-col split-r" id={organisations.id}>
    <div class="inner">
      <p class="kicker">{organisations.kicker}</p>
      <h2>{organisations.title}</h2>
      <p class="support">{organisations.support}</p>
      <a class="btn btn-primary" href={sitePath(organisations.cta.href)}>{organisations.cta.label}</a>
    </div>
  </div>
</section>
