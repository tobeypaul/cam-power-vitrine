---
import logo from '../assets/brand/logo.png';
import { htmlLang, locales, ogLocale, otherLocale, route, t, type Locale, type RouteKey } from '../i18n';
import { sitePath } from '../lib/paths';
import { organizationGraph } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
}

const { title, description, locale, routeKey } = Astro.props;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = absolute(Astro.url.pathname);
const logoUrl = absolute(logo.src);
const structuredData = organizationGraph(canonical, description, logoUrl, htmlLang[locale]);
const alternates = locales.map((code) => ({
  code,
  href: absolute(sitePath(route(routeKey, code))),
}));
const xDefault = alternates.find((alternate) => alternate.code === 'fr')!.href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={htmlLang[alternate.code]} href={alternate.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" type="image/png" href={logo.src} />
    <meta name="theme-color" content="#1B3A8A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale(locale)]} />
    <meta property="og:site_name" content="CamPower" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t(locale).skip}</a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
