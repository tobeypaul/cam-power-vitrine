---
import logo from '../assets/brand/logo.png';
import { htmlLang, locales, ogLocale, otherLocale, route, t, type Locale, type RouteKey } from '../i18n';
import { sitePath } from '../lib/paths';
import { structuredDataGraph } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
  noindex?: boolean;
  /** Short page name for the breadcrumb. Defaults to the part of the title before the dash. */
  pageName?: string;
  /** Extra JSON-LD nodes for this page, for example an FAQPage. */
  schema?: Record<string, unknown>[];
}

const { title, description, locale, routeKey, noindex: pageNoindex = false, pageName, schema = [] } = Astro.props;
const noindex = pageNoindex || String(import.meta.env.SITE_NOINDEX) === 'true';
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = absolute(Astro.url.pathname);
const logoUrl = absolute(logo.src);
const shareImage = absolute(sitePath(`/og/campower-${locale}.jpg`));
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.BING_SITE_VERIFICATION;
const alternates = locales.map((code) => ({
  code,
  href: absolute(sitePath(route(routeKey, code))),
}));
const xDefault = alternates.find((alternate) => alternate.code === 'fr')!.href;
const structuredData = structuredDataGraph({
  siteUrl: absolute(sitePath(route('home', 'fr'))),
  homeUrl: absolute(sitePath(route('home', locale))),
  pageUrl: canonical,
  pageName: pageName ?? title.split(' — ')[0]!,
  homeName: t(locale).homeName,
  description,
  logoUrl,
  locale: htmlLang[locale],
  isHome: routeKey === 'home',
  extra: schema,
});
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map((alternate) => <link rel="alternate" hreflang={htmlLang[alternate.code]} href={alternate.href} />)}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    )}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="icon" type="image/png" href={logo.src} />
    <meta name="theme-color" content="#1B3A8A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale(locale)]} />
    <meta property="og:site_name" content="CamPower" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(locale).shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t(locale).skip}</a>
    <slot />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
