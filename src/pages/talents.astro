---
import { Image } from 'astro:assets';
import profileCard from '../assets/screens/profile-card.png';
import screenFeed from '../assets/screens/screen-feed.png';
import screenOffers from '../assets/screens/screen-offers.png';
import screenRecruit from '../assets/screens/screen-recruit.png';
import Arrow from '../components/Arrow.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getHomepage, getTalents } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/talents.css';

const home = getHomepage('fr');
const page = getTalents('fr');
const footer = {
  ...home.footer,
  columns: home.footer.columns.map((column) => ({
    ...column,
    links: column.links.map((link) =>
      link.href.startsWith('#') && link.href !== '#mentions' ? { ...link, href: `/${link.href}` } : link,
    ),
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description}>
  <SiteHeader nav={page.nav} access={home.hero.access} logoHref="/" />
  <main id="contenu" class="talents">
    <section class="hero" aria-labelledby="talents-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 id="talents-title">{page.hero.title}</h1>
          <p class="lead">{page.hero.lead}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={home.hero.access.href}>{home.hero.access.label} <Arrow /></a>
            <a class="link-more" href={page.hero.explore.href}>
              {page.hero.explore.label}
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 3v10M4.2 9.2 8 13l3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
        <aside class="journey" aria-label="Ce que cette page explique">
          <p class="kicker">{page.hero.panelKicker}</p>
          <p class="journey-line">{page.hero.panelLine}</p>
          <ol class="seq">
            {page.hero.dimensions.map((item) => (
              <li><strong>{item.label}</strong><span>{item.text}</span></li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <section class="presence" id="parcours" aria-labelledby="identity-title">
      <div class="wrap">
        <div class="presence-top">
          <figure class="idcard">
            <Image src={profileCard} alt="Profil dans l’application CamPower" widths={[280, 560]} sizes="280px" quality={80} />
          </figure>
          <article>
            <p class="kicker">{page.identity.kicker}</p>
            <h2 id="identity-title">{page.identity.title}</h2>
            <p class="support">{page.identity.support}</p>
          </article>
        </div>
        <article class="skill-note" aria-labelledby="skills-title">
          <p class="kicker">{page.skills.kicker}</p>
          <h3 id="skills-title">{page.skills.title}</h3>
          <p class="support">{page.skills.support}</p>
          <ul class="caps">
            {page.skills.items.map((item) => (
              <li><strong>{item.label}</strong><span>{item.text}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="network" aria-labelledby="network-title">
      <div class="wrap net-grid">
        <figure class="net-panel">
          <svg viewBox="0 0 560 320" aria-hidden="true">
            <g fill="none" stroke="#16803C" stroke-width="1.5" stroke-linecap="round">
              <path d="M270 150 L270 52"></path>
              <path d="M270 150 L150 64"></path>
              <path d="M270 150 L400 78"></path>
              <path d="M270 150 L478 150"></path>
              <path d="M270 150 L448 228"></path>
              <path d="M270 150 L392 286"></path>
              <path d="M270 150 L112 250"></path>
              <path d="M270 150 L78 176"></path>
              <path d="M150 64 L270 52" stroke-opacity="0.5"></path>
              <path d="M400 78 L478 150" stroke-opacity="0.5"></path>
              <path d="M448 228 L392 286" stroke-opacity="0.5"></path>
              <path d="M112 250 L78 176" stroke-opacity="0.5"></path>
            </g>
            <g fill="#fff" stroke="#1B3A8A" stroke-width="2">
              <circle cx="270" cy="52" r="8"></circle>
              <circle cx="150" cy="64" r="8"></circle>
              <circle cx="478" cy="150" r="8"></circle>
              <circle cx="448" cy="228" r="8"></circle>
              <circle cx="392" cy="286" r="8"></circle>
              <circle cx="112" cy="250" r="8"></circle>
              <circle cx="78" cy="176" r="8"></circle>
            </g>
            <circle cx="400" cy="78" r="8" fill="#F5C518" stroke="#E2B40A" stroke-width="2"></circle>
            <circle cx="270" cy="150" r="30" fill="#1B3A8A"></circle>
            <text x="270" y="155" text-anchor="middle">Profil</text>
          </svg>
        </figure>
        <div>
          <p class="kicker">{page.network.kicker}</p>
          <h2 id="network-title">{page.network.title}</h2>
          <p class="support">{page.network.support}</p>
        </div>
      </div>
    </section>

    <section class="opp" aria-labelledby="opportunities-title">
      <div class="wrap opp-grid">
        <div>
          <p class="eyebrow">{page.opportunities.eyebrow}</p>
          <h2 id="opportunities-title">{page.opportunities.title}</h2>
          <p class="support">{page.opportunities.support}</p>
          <div class="model">
            <p class="model-root"><span class="dot" aria-hidden="true"></span> {page.opportunities.root}</p>
            <div class="model-split">
              {page.opportunities.branches.map((branch) => (
                <article>
                  <h3>{branch.title}</h3>
                  <p>{branch.text}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
        <figure>
          <PhoneFrame src={screenOffers} alt="Offres dans l’application CamPower" variant="offers" />
          <figcaption class="phone-note">{page.opportunities.note}</figcaption>
        </figure>
      </div>
    </section>

    <section class="routes" aria-labelledby="routes-title">
      <div class="wrap">
        <p class="eyebrow">{page.routes.eyebrow}</p>
        <h2 id="routes-title">{page.routes.title}</h2>
        <div class="route-grid">
          <article class="route route-emploi">
            <p class="kicker">{page.routes.employment.kicker}</p>
            <h3>{page.routes.employment.title}</h3>
            <p>{page.routes.employment.text}</p>
          </article>
          <article class="route route-mission">
            <p class="kicker">{page.routes.missions.kicker}</p>
            <h3>{page.routes.missions.title}</h3>
            <p>{page.routes.missions.text}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="value" aria-labelledby="value-title">
      <div class="wrap value-grid">
        <div>
          <p class="eyebrow">{page.organisations.eyebrow}</p>
          <h2 id="value-title">{page.organisations.title}</h2>
          <p class="support">{page.organisations.support}</p>
          <ul class="pair">
            {page.organisations.sides.map((side) => (
              <li>
                <strong>{side.title}</strong>
                <span>{side.text}</span>
              </li>
            ))}
          </ul>
        </div>
        <figure>
          <PhoneFrame src={screenRecruit} alt="Consultation de profils dans l’application CamPower" />
          <figcaption class="phone-note">{page.organisations.note}</figcaption>
        </figure>
      </div>
    </section>

    <section class="life" aria-labelledby="life-title">
      <div class="wrap">
        <h2 id="life-title">{page.lifecycle.title}</h2>
        <p class="support">{page.lifecycle.support}</p>
        <ol class="life-steps">
          {page.lifecycle.steps.map((step) => (
            <li><strong>{step.label}</strong><span>{step.text}</span></li>
          ))}
        </ol>
        <p class="life-note">{page.lifecycle.note}</p>
      </div>
    </section>

    <section class="place" aria-labelledby="cameroon-title">
      <div class="wrap place-grid">
        <div>
          <div class="tricolor" aria-hidden="true"><i></i><i></i><i></i></div>
          <h2 id="cameroon-title">{page.cameroon.title}</h2>
          <p class="support">{page.cameroon.support}</p>
        </div>
        <svg class="cmap" viewBox="0 0 160 220" aria-hidden="true">
          <path fill="#1B3A8A" fill-opacity="0.16" stroke="#1B3A8A" stroke-opacity="0.55" stroke-width="1.6" d="M 125.4 4.0 L 133.4 16.2 L 134.7 28.8 L 134.0 41.5 L 145.0 58.8 L 133.7 58.6 L 128.0 60.0 L 118.8 58.0 L 114.4 67.0 L 126.3 78.2 L 135.1 81.4 L 138.0 89.3 L 144.3 102.4 L 141.2 107.6 L 131.0 126.9 L 126.2 130.3 L 124.6 145.1 L 126.6 153.1 L 125.0 158.8 L 134.5 168.7 L 136.3 175.6 L 143.7 185.4 L 153.0 191.5 L 153.9 200.2 L 156.0 205.7 L 154.5 216.0 L 138.5 211.5 L 122.2 206.5 L 96.7 205.7 L 94.2 204.7 L 82.2 207.1 L 69.9 204.6 L 60.3 205.8 L 27.4 205.4 L 30.4 190.4 L 22.5 177.8 L 13.3 174.6 L 9.2 166.0 L 4.0 163.3 L 4.2 158.0 L 9.4 144.5 L 19.0 126.2 L 24.9 126.0 L 36.9 114.9 L 44.6 114.5 L 55.9 122.4 L 69.8 115.9 L 71.7 108.0 L 76.2 100.4 L 79.4 90.7 L 90.2 82.9 L 94.2 69.5 L 98.5 65.3 L 101.4 55.4 L 106.7 43.2 L 123.7 28.5 L 124.8 22.2 L 127.0 18.7 L 119.0 11.2 L 119.7 5.1 L 125.4 4.0 Z"></path>
        </svg>
      </div>
    </section>

    <section class="daily" aria-labelledby="daily-title">
      <div class="wrap daily-grid">
        <PhoneFrame src={screenFeed} alt="Application CamPower sur téléphone" />
        <div>
          <h2 id="daily-title">{page.daily.title}</h2>
          <p class="support">{page.daily.support}</p>
          <a class="play" href={page.daily.storeHref} target="_blank" rel="noopener noreferrer">
            <svg width="22" height="24" viewBox="0 0 22 24" aria-hidden="true">
              <path d="M2 1.8c0-1 1.1-1.6 2-1.1L20.2 10c.9.5.9 1.8 0 2.3L4 22.6c-.9.5-2-.1-2-1.1V1.8z" fill="#fff"></path>
            </svg>
            <span>
              <small>{page.daily.storeKicker}</small>
              <strong>{page.daily.storeName}</strong>
              <span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="finale" aria-labelledby="finale-title">
      <h2 id="finale-title">{page.finale.title}</h2>
      <p>{page.finale.support}</p>
      <a class="btn btn-primary" href={home.hero.access.href}>{home.hero.access.label} <Arrow /></a>
    </section>
  </main>
  <SiteFooter footer={footer} homeHref="/" />
</BaseLayout>
