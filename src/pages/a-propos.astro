---
import Arrow from '../components/Arrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getAPropos, getHomepage } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/a-propos.css';

const home = getHomepage('fr');
const page = getAPropos('fr');
const footer = {
  ...home.footer,
  columns: home.footer.columns.map((column) => ({
    ...column,
    links: column.links.map((link) =>
      link.href.startsWith('#') && link.href !== '#mentions' ? { ...link, href: `/${link.href}` } : link,
    ),
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description}>
  <SiteHeader nav={page.nav} access={home.hero.access} logoHref="/" />
  <main id="contenu" class="apropos">
    <section class="hero" data-motion="hero" aria-labelledby="apropos-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 id="apropos-title">{page.hero.title}</h1>
          <p class="lead">{page.hero.lead}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={home.hero.access.href}>{home.hero.access.label} <Arrow /></a>
            <a class="link-more" href={page.hero.explore.href}>
              {page.hero.explore.label}
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 3v10M4.2 9.2 8 13l3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
        <figure class="connect">
          <div class="connect-row">
            <ul class="sources">
              {page.hero.sources.map((source) => (
                <li><strong>{source.title}</strong><span>{source.text}</span></li>
              ))}
            </ul>
            <p class="via">{page.hero.gathered}</p>
            <p class="hub"><strong>{page.hero.hub.title}</strong><span>{page.hero.hub.text}</span></p>
            <p class="via">{page.hero.toward}</p>
            <p class="dest"><strong>{page.hero.destination.title}</strong><span>{page.hero.destination.text}</span></p>
          </div>
          <figcaption>{page.hero.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="why" id="ambition" aria-labelledby="purpose-title">
      <div class="wrap why-grid">
        <div>
          <p class="kicker">{page.purpose.kicker}</p>
          <h2 id="purpose-title">{page.purpose.title}</h2>
        </div>
        <div>
          <p class="statement">{page.purpose.statement}</p>
          <p class="mark">{page.purpose.mark}</p>
        </div>
      </div>
      <div class="wrap">
        <p class="support">{page.purpose.support}</p>
        <ul class="realities">
          {page.purpose.realities.map((item, index) => (
            <li data-motion="reveal" style={`--motion-i:${index}`}><strong>{item.title}</strong><span>{item.text}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="belief" data-motion="reveal" aria-labelledby="conviction-title">
      <div class="wrap">
        <p class="kicker">{page.conviction.kicker}</p>
        <h2 id="conviction-title">{page.conviction.title}</h2>
        <p class="quote">{page.conviction.quote}</p>
        <p class="support">{page.conviction.support}</p>
        <div class="belief-grid">
          <ol class="chain">
            {page.conviction.steps.map((step) => (
              <li><strong>{step.title}</strong><span>{step.text}</span></li>
            ))}
          </ol>
          <article class="org">
            <p class="kicker">{page.conviction.enterprise.kicker}</p>
            <p class="org-title">{page.conviction.enterprise.title}</p>
            <p>{page.conviction.enterprise.text}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="life" data-motion="reveal" aria-labelledby="ecosystem-title">
      <div class="wrap">
        <p class="kicker">{page.ecosystem.kicker}</p>
        <h2 id="ecosystem-title">{page.ecosystem.title}</h2>
        <p class="support">{page.ecosystem.support}</p>
        <ol class="weave" aria-label="Ce qui avance ensemble">
          {page.ecosystem.items.map((item, index) => (
            <li>
              {item}
              {index < page.ecosystem.items.length - 1 && <span class="rule" aria-hidden="true"></span>}
            </li>
          ))}
        </ol>
        <div class="forms">
          <p class="forms-label">{page.ecosystem.formsLabel}</p>
          <ul>
            {page.ecosystem.forms.map((form) => (
              <li><strong>{form.title}</strong><span>{form.text}</span></li>
            ))}
          </ul>
          <p class="life-note">{page.ecosystem.note}</p>
        </div>
      </div>
    </section>

    <section class="community" data-motion="reveal" aria-labelledby="community-title">
      <div class="wrap">
        <p class="kicker">{page.community.kicker}</p>
        <h2 id="community-title">{page.community.title}</h2>
        <p class="support">{page.community.support}</p>
        <p class="tagline-xl">{page.community.tagline}</p>
      </div>
    </section>

    <section class="place" data-motion="reveal" aria-labelledby="cameroon-title">
      <div class="wrap place-grid">
        <div>
          <div class="tricolor" aria-hidden="true"><i></i><i></i><i></i></div>
          <h2 id="cameroon-title">{page.cameroon.title}</h2>
          <p class="support">{page.cameroon.support}</p>
        </div>
        <svg class="cmap" viewBox="0 0 160 220" aria-hidden="true">
          <path fill="#1B3A8A" fill-opacity="0.16" stroke="#1B3A8A" stroke-opacity="0.55" stroke-width="1.6" d="M 125.4 4.0 L 133.4 16.2 L 134.7 28.8 L 134.0 41.5 L 145.0 58.8 L 133.7 58.6 L 128.0 60.0 L 118.8 58.0 L 114.4 67.0 L 126.3 78.2 L 135.1 81.4 L 138.0 89.3 L 144.3 102.4 L 141.2 107.6 L 131.0 126.9 L 126.2 130.3 L 124.6 145.1 L 126.6 153.1 L 125.0 158.8 L 134.5 168.7 L 136.3 175.6 L 143.7 185.4 L 153.0 191.5 L 153.9 200.2 L 156.0 205.7 L 154.5 216.0 L 138.5 211.5 L 122.2 206.5 L 96.7 205.7 L 94.2 204.7 L 82.2 207.1 L 69.9 204.6 L 60.3 205.8 L 27.4 205.4 L 30.4 190.4 L 22.5 177.8 L 13.3 174.6 L 9.2 166.0 L 4.0 163.3 L 4.2 158.0 L 9.4 144.5 L 19.0 126.2 L 24.9 126.0 L 36.9 114.9 L 44.6 114.5 L 55.9 122.4 L 69.8 115.9 L 71.7 108.0 L 76.2 100.4 L 79.4 90.7 L 90.2 82.9 L 94.2 69.5 L 98.5 65.3 L 101.4 55.4 L 106.7 43.2 L 123.7 28.5 L 124.8 22.2 L 127.0 18.7 L 119.0 11.2 L 119.7 5.1 L 125.4 4.0 Z"></path>
        </svg>
      </div>
    </section>

    <section class="vision" data-motion="reveal" aria-labelledby="vision-title">
      <div class="wrap">
        <p class="kicker">{page.vision.kicker}</p>
        <h2 id="vision-title">{page.vision.title}</h2>
        <p class="lead">{page.vision.lead}</p>
        <ol class="aims">
          {page.vision.aims.map((aim) => (
            <li>{aim}</li>
          ))}
        </ol>
        <p class="toward"><i aria-hidden="true"></i> {page.vision.toward}</p>
        <p class="vision-note">{page.vision.note}</p>
      </div>
    </section>

    <section class="growth" data-motion="reveal" aria-labelledby="growth-title">
      <div class="wrap">
        <p class="kicker">{page.growth.kicker}</p>
        <h2 id="growth-title">{page.growth.title}</h2>
        <p class="support">{page.growth.support}</p>
      </div>
    </section>

    <section class="finale" data-motion="reveal" aria-labelledby="finale-title">
      <h2 id="finale-title">{page.finale.title}</h2>
      <p>{page.finale.support}</p>
      <a class="btn btn-primary" href={home.hero.access.href}>{home.hero.access.label} <Arrow /></a>
    </section>
  </main>
  <SiteFooter footer={footer} homeHref="/" />
</BaseLayout>
