---
import { Image } from 'astro:assets';
import screenFeed from '../assets/screens/screen-feed.jpg';
import screenOffer from '../assets/screens/screen-offer.jpg';
import screenOffers from '../assets/screens/screen-offers.jpg';
import screenProfile from '../assets/screens/screen-profile.jpg';
import Arrow from '../components/Arrow.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getDecouvrir, getHomepage } from '../content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/decouvrir.css';
import { sitePath } from '../lib/paths';

const home = getHomepage('fr');
const page = getDecouvrir('fr');
const footer = {
  ...home.footer,
  columns: home.footer.columns.map((column) => ({
    ...column,
    links: column.links.map((link) =>
      link.href.startsWith('#') && link.href !== '#mentions' ? { ...link, href: sitePath(`/${link.href}`) } : link,
    ),
  })),
};
---

<BaseLayout title={page.meta.title} description={page.meta.description}>
  <SiteHeader nav={page.nav} access={home.hero.access} logoHref="/" />
  <main id="contenu" class="discover">
    <section class="hero" data-motion="hero" aria-labelledby="discover-title">
      <div class="wrap hero-grid">
        <div>
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 id="discover-title">
            {page.hero.titleLines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </h1>
          <p class="lead">{page.hero.lead}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={sitePath(home.hero.access.href)}>{home.hero.access.label} <Arrow /></a>
            <a class="link-more" href={sitePath(page.hero.ecosystem.href)}>
              {page.hero.ecosystem.label}
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 3v10M4.2 9.2 8 13l3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
        <div>
          <ol class="spine">
            {page.hero.spine.map((item) => <li>{item}</li>)}
          </ol>
          <p class="spine-note">{page.hero.spineNote}</p>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="possibilites-title">
      <div class="wrap">
        <div class="band-head" data-motion="reveal">
          <h2 id="possibilites-title">
            {page.possibilities.titleLines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </h2>
          <p>{page.possibilities.dek}</p>
        </div>
        <ol class="path">
          {page.possibilities.steps.map((step, index) => (
            <li data-motion="reveal" style={`--motion-i:${index}`}>
              <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="block" data-motion="reveal" aria-labelledby="identity-title">
      <div class="wrap bridge">
        <div>
          <p class="kicker">{page.identity.kicker}</p>
          <h2 id="identity-title">{page.identity.title}</h2>
          <p class="support">{page.identity.support}</p>
          <figure class="idcard">
            <Image src={screenProfile} alt="Profil dans l’application CamPower" widths={[250, 500]} sizes="250px" quality={80} />
          </figure>
        </div>
        <div class="bridge-join" aria-hidden="true"><span></span></div>
        <div>
          <p class="kicker">{page.network.kicker}</p>
          <h2>{page.network.title}</h2>
          <p class="support">{page.network.support}</p>
          <figure class="net-panel">
            <svg viewBox="0 0 300 280" aria-hidden="true">
              <g fill="none" stroke="#16803C" stroke-width="1.5" stroke-linecap="round">
                <path d="M150 108 L150 36"></path>
                <path d="M150 108 L246 62"></path>
                <path d="M150 108 L258 154"></path>
                <path d="M150 108 L214 228"></path>
                <path d="M150 108 L86 228"></path>
                <path d="M150 108 L42 154"></path>
                <path d="M150 108 L58 62"></path>
                <path d="M150 36 L246 62" stroke-opacity="0.55"></path>
                <path d="M246 62 L258 154" stroke-opacity="0.55"></path>
                <path d="M86 228 L42 154" stroke-opacity="0.55"></path>
                <path d="M214 228 L258 154" stroke-opacity="0.55"></path>
              </g>
              <g fill="#fff" stroke="#1B3A8A" stroke-width="2">
                <circle cx="150" cy="36" r="7"></circle>
                <circle cx="258" cy="154" r="7"></circle>
                <circle cx="214" cy="228" r="7"></circle>
                <circle cx="86" cy="228" r="7"></circle>
                <circle cx="42" cy="154" r="7"></circle>
                <circle cx="58" cy="62" r="7"></circle>
              </g>
              <circle cx="246" cy="62" r="7" fill="#F5C518" stroke="#E2B40A" stroke-width="2"></circle>
              <circle cx="150" cy="108" r="18" fill="#1B3A8A"></circle>
              <rect x="114" y="138" width="72" height="24" rx="6" fill="#fff"></rect>
              <text x="150" y="155" text-anchor="middle">Profil</text>
            </svg>
          </figure>
        </div>
      </div>
    </section>

    <section class="opp" data-motion="reveal" aria-labelledby="opportunities-title">
      <div class="wrap opp-grid">
        <div>
          <p class="eyebrow">{page.opportunities.eyebrow}</p>
          <h2 id="opportunities-title">{page.opportunities.title}</h2>
          <p class="support">{page.opportunities.support}</p>
        </div>
        <PhoneFrame src={screenOffers} alt="Offres dans l’application CamPower" variant="offers" />
      </div>
    </section>

    <section class="meet" data-motion="reveal" aria-labelledby="meeting-title">
      <div class="wrap">
        <h2 id="meeting-title">{page.meeting.title}</h2>
        <p class="dek">{page.meeting.dek}</p>
        <div class="meet-stage">
          <article class="meet-side meet-pro">
            <h3>{page.meeting.professionalsTitle}</h3>
            <p>{page.meeting.professionalsBody}</p>
          </article>
          <PhoneFrame src={screenOffer} alt="Détail d’une offre dans l’application CamPower" />
          <article class="meet-side meet-org">
            <h3>{page.meeting.organisationsTitle}</h3>
            <p>{page.meeting.organisationsBody}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="missions" data-motion="reveal" aria-labelledby="missions-title">
      <div class="wrap">
        <p class="eyebrow">{page.missions.eyebrow}</p>
        <h2 id="missions-title">{page.missions.title}</h2>
        <p class="support">{page.missions.support}</p>
        <div class="mission-line">
          <article>
            <h3>{page.missions.leftTitle}</h3>
            <p>{page.missions.leftBody}</p>
          </article>
          <div class="mission-join" aria-hidden="true">+</div>
          <article>
            <h3>{page.missions.rightTitle}</h3>
            <p>{page.missions.rightBody}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ensemble" id="ensemble" data-motion="reveal" aria-labelledby="ensemble-title">
      <div class="wrap">
        <h2 id="ensemble-title">{page.ecosystem.title}</h2>
        <p class="dek">{page.ecosystem.dek}</p>
        <ol class="chain">
          {page.ecosystem.chain.map((item, index) => (
            <li>
              {item}
              {index < page.ecosystem.chain.length - 1 && <span class="rule" aria-hidden="true"></span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cm-block" data-motion="reveal" aria-labelledby="cameroon-title">
      <div class="wrap cm-grid">
        <div>
          <div class="tricolor" aria-hidden="true"><i></i><i></i><i></i></div>
          <h2 id="cameroon-title">{page.cameroon.title}</h2>
          <p class="dek">{page.cameroon.dek}</p>
        </div>
        <svg class="cmap" viewBox="0 0 160 220" aria-hidden="true">
          <path fill="#1B3A8A" fill-opacity="0.16" stroke="#1B3A8A" stroke-opacity="0.55" stroke-width="1.6" d="M 125.4 4.0 L 133.4 16.2 L 134.7 28.8 L 134.0 41.5 L 145.0 58.8 L 133.7 58.6 L 128.0 60.0 L 118.8 58.0 L 114.4 67.0 L 126.3 78.2 L 135.1 81.4 L 138.0 89.3 L 144.3 102.4 L 141.2 107.6 L 131.0 126.9 L 126.2 130.3 L 124.6 145.1 L 126.6 153.1 L 125.0 158.8 L 134.5 168.7 L 136.3 175.6 L 143.7 185.4 L 153.0 191.5 L 153.9 200.2 L 156.0 205.7 L 154.5 216.0 L 138.5 211.5 L 122.2 206.5 L 96.7 205.7 L 94.2 204.7 L 82.2 207.1 L 69.9 204.6 L 60.3 205.8 L 27.4 205.4 L 30.4 190.4 L 22.5 177.8 L 13.3 174.6 L 9.2 166.0 L 4.0 163.3 L 4.2 158.0 L 9.4 144.5 L 19.0 126.2 L 24.9 126.0 L 36.9 114.9 L 44.6 114.5 L 55.9 122.4 L 69.8 115.9 L 71.7 108.0 L 76.2 100.4 L 79.4 90.7 L 90.2 82.9 L 94.2 69.5 L 98.5 65.3 L 101.4 55.4 L 106.7 43.2 L 123.7 28.5 L 124.8 22.2 L 127.0 18.7 L 119.0 11.2 L 119.7 5.1 L 125.4 4.0 Z"></path>
        </svg>
      </div>
    </section>

    <section class="daily" data-motion="reveal" aria-labelledby="daily-title">
      <div class="wrap daily-grid">
        <PhoneFrame src={screenFeed} alt="Fil d’actualité dans l’application CamPower" />
        <div class="daily-copy">
          <h2 id="daily-title">{page.daily.title}</h2>
          <p class="support">{page.daily.support}</p>
          <a class="play" href={sitePath(page.daily.storeHref)} target="_blank" rel="noopener noreferrer">
            <svg width="22" height="24" viewBox="0 0 22 24" aria-hidden="true">
              <path d="M2 1.8c0-1 1.1-1.6 2-1.1L20.2 10c.9.5.9 1.8 0 2.3L4 22.6c-.9.5-2-.1-2-1.1V1.8z" fill="#fff"></path>
            </svg>
            <span>
              <small>{page.daily.storeKicker}</small>
              <strong>{page.daily.storeName}</strong>
              <span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="finale" data-motion="reveal" aria-labelledby="finale-title">
      <h2 id="finale-title">{page.finale.title}</h2>
      <p>{page.finale.support}</p>
      <a class="btn btn-primary" href={sitePath(home.hero.access.href)}>{home.hero.access.label} <Arrow /></a>
    </section>
  </main>
  <SiteFooter footer={footer} homeHref="/" />
</BaseLayout>
