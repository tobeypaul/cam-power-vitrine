# Public origin of the Site Vitrine, without the path in `base`.
# Used for canonical URLs, hreflang, Open Graph and the sitemap.
# This is not the CamPower application URL.
# GitHub Pages project site: https://tobeypaul.github.io
# Subdomain deploy: the full subdomain, for example https://vitrine.example.cm
# Do not point it at https://cam-power.net/.
# Leave it empty to build without absolute URLs and without a sitemap.
SITE_URL=

# Path the site is served from.
# GitHub Pages project site: /cam-power-vitrine (the default when empty)
# Root of a subdomain: /
BASE_PATH=
